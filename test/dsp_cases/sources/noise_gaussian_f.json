{
  "name": "noise_gaussian_f",
  "description": "noise_source_f gaussian, amplitude 0.2, statistics against GNU Radio",
  "samples": 100000,
  "seed": 1,
  "input": {
    "type": "none"
  },
  "output": {
    "type": "real"
  },
  "params": {
    "amp": 0.2,
    "nseed": 42
  },
  "block": {
    "name": "noise_source_f",
    "opts": {
      "type": "gaussian",
      "amplitude": 0.2,
      "seed": 42
    }
  },
  "gnuradio": [
    {
      "block": "analog.noise_source_f",
      "args": [
        "analog.GR_GAUSSIAN",
        "amp",
        "nseed"
      ]
    }
  ],
  "stats_only": true
}
