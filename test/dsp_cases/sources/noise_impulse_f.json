      "amplitude": 0.05,
      "seed": 42
    }
  },
  "gnuradio": [
    {
      "block": "analog.noise_source_f",
      "args": [
        "analog.GR_IMPULSE",
        "amp",
        "nseed"
      ]
    }
  ],
  "stats_only": true
}
